{
  "api_version": "1.0",
  "component_version": "0.3.0",
  "employee_id": "engine",
  "backend": "libpinyin",
  "backend_version": "2.6.0",
  "license": "GPL-3.0-or-later",
  "schemas": [
    "full_pinyin",
    "double_pinyin"
  ],
  "features": {
    "sentence": true,
    "candidates": true,
    "partial_selection": true,
    "editing": true,
    "session_isolation": true,
    "pagination": true,
    "double_pinyin": true,
    "fuzzy_pinyin": true,
    "correction": true,
    "dictionary_import": true,
    "learning": true,
    "privacy_context": true,
    "user_phrases": true
  },
  "double_pinyin_schemes": {
    "ziranma": {
      "name": "自然码双拼",
      "native_id": 1
    }
  },
  "fuzzy_rules": [
    "c_ch",
    "s_sh",
    "z_zh",
    "f_h",
    "g_k",
    "l_n",
    "l_r",
    "an_ang",
    "en_eng",
    "in_ing"
  ],
  "correction_rules": [
    "gn_ng",
    "mg_ng",
    "iou_iu",
    "uei_ui",
    "uen_un",
    "ue_ve",
    "v_u",
    "on_ong",
    "transpose",
    "delete",
    "insert",
    "substitute"
  ],
  "correction_scope": "8 native syllable rules plus bounded single-edit repairs of incomplete full-pinyin spellings (5..64 letters); valid full pinyin and double-pinyin are not rewritten",
  "learning_requires": "explicit user_data_dir, store master switch and session learning=true",
  "operations": [
    "set_context",
    "add_phrase",
    "remove_phrase",
    "import_dictionary",
    "reload_lexicon",
    "learning_status"
  ],
  "config_defaults": {
    "schema": "full_pinyin",
    "page_size": 5,
    "incomplete": true,
    "learning": false,
    "double_pinyin_scheme": "ziranma",
    "fuzzy": {
      "enabled": false,
      "rules": []
    },
    "correction": {
      "enabled": true,
      "rules": []
    }
  },
  "max_input_length": 128,
  "max_sessions": 64,
  "coordinate_unit": "unicode_codepoint",
  "network": false
}
