{
  "version": 1,
  "input": {
    "schema": "full_pinyin",
    "page_size": 5,
    "incomplete": true,
    "learning": false,
    "prediction": false,
    "shift_toggle": true,
    "double_pinyin_scheme": null,
    "fuzzy": {"enabled": false, "rules": []},
    "correction": {"enabled": false, "rules": []}
  },
  "punctuation": {"chinese": true, "use_full_width_pairs": true},
  "shortcuts": {
    "toggle_mode": "Control+space",
    "select_digit": "1-9",
    "page_prev": "Page_Up",
    "page_next": "Page_Down",
    "move_prev": "Up",
    "move_next": "Down",
    "commit_raw": "Return",
    "cancel": "Escape",
    "pass_focus": "Tab"
  },
  "panel": {
    "layout": "horizontal",
    "font_scale": 1.0,
    "max_visible": 9,
    "show_page_info": false,
    "show_hints": false,
    "edge_margin": 8
  },
  "ui": {"language": "zh_CN"}
}
