def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def tree_digest(path, skip=()):
    """目录内容摘要：对排序后的 <相对路径, sha256> 求哈希。"""
    h = hashlib.sha256()
    count = 0
    total = 0
    for base, dirs, names in os.walk(path):
        dirs.sort()
        kept = []
        for name in sorted(dirs):
            rel = os.path.relpath(os.path.join(base, name), path).replace(os.sep, "/")
            if any(rel == s or rel.startswith(s + "/") for s in skip):
                continue
            kept.append(name)
        dirs[:] = kept
        for name in sorted(names):
            full = os.path.join(base, name)
            if os.path.islink(full):
                continue
            rel = os.path.relpath(full, path).replace(os.sep, "/")
            if any(rel == s or rel.startswith(s + "/") for s in skip):
                continue
            if rel.endswith(".pyc") or "__pycache__" in rel:
                continue
            digest = sha256_file(full)
            size = os.path.getsize(full)
            h.update(("%s\0%s\n" % (rel, digest)).encode("utf-8"))
            count += 1
            total += size
    return {"digest": h.hexdigest(), "files": count, "bytes": total}


def classify(rel):
    if rel == "bin/server-ime":
        return "executable", "0755"
    if rel.startswith("engine/vendor/runtime/lib/"):
        return "library", "0644"
    if rel.startswith("engine/vendor/runtime/data/"):
        return "data", "0644"
    if rel.startswith("engine/vendor/runtime/licenses/"):
        return "doc", "0644"
    name = rel.rsplit("/", 1)[-1]
    if name in ("LICENSE", "COPYING", "SOURCES.md", "AUTHORS", "README.md") or rel.endswith(".md"):
        return "doc", "0644"
    if rel.endswith(".py"):
        return "library", "0644"
    if rel.endswith(".json"):
        return "config", "0644"
    return "data", "0644"


def stage_payload(product, payload):
    if payload.exists():
        shutil.rmtree(payload)
    payload.mkdir(parents=True)
    skipped = []

    def skip(rel):
        for prefix in EXCLUDE_FROM_PAYLOAD:
            if rel == prefix or rel.startswith(prefix + "/"):
                return True
        return rel.endswith(".pyc") or "__pycache__" in rel

    for base, dirs, names in os.walk(product):
        dirs.sort()
        rel_base = os.path.relpath(base, product).replace(os.sep, "/")
        rel_base = "" if rel_base == "." else rel_base
        dirs[:] = [d for d in sorted(dirs) if not skip((rel_base + "/" + d).lstrip("/"))]
        for name in sorted(names):
            src = Path(base) / name
            rel = (rel_base + "/" + name).lstrip("/")
            if skip(rel):
                skipped.append(rel)
                continue
            dst = payload / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, dst)
            dst.chmod(0o755 if rel in ("bin/server-ime", "integration/bin/server-ime") else 0o644)
    return skipped


def stage_release_docs(payload):
    """把许可/来源材料与中文说明显式暂存进安装载荷。

    返回 (staged, missing)：staged 为 [{path, sha256, size, source}]；missing 为缺失项。
    缺失任意一项时调用方必须中止构建（退出码 5）。
    """
    staged = []
    missing = []
    for src_rel, dst_rel in REQUIRED_LICENSE_MEMBERS:
        src = ROOT / src_rel
        if not src.is_file() or src.stat().st_size == 0:
            missing.append(src_rel)
            continue
        dst = payload / dst_rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        dst.chmod(0o644)
        staged.append({"path": dst_rel, "sha256": sha256_file(dst), "size": dst.stat().st_size, "source": src_rel})
    guide = payload / PAYLOAD_GUIDE
    guide.parent.mkdir(parents=True, exist_ok=True)
    guide.write_text(GUIDE_TEXT, encoding="utf-8")
    guide.chmod(0o644)
    staged.append({"path": PAYLOAD_GUIDE, "sha256": sha256_file(guide), "size": guide.stat().st_size, "source": "ime-build:GUIDE_TEXT"})
    return staged, missing


