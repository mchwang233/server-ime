#!/usr/bin/env python3
"""ime-build：把各组件当前交付装配为可安装的统一发布包（ime-bundle/1）。

流程（全部在 delivery/build/<版本>/ 内完成，可重复执行）：

1. 调用 integration/tools/build_product.py 装配产品根（platform 所有），并校验
   engine/vendor.lock.json 中锁定的 libpinyin 运行时哈希。
2. 复制为 payload：只保留运行所需文件；源码包（*.src.rpm、libpinyin 源码 tar）
   不进入安装载荷，单独打成 -sources.tar.gz 供 GPL 源码合规。许可/来源材料（含
   interface/LICENSE、interface/SOURCES.md）与中文快速说明显式暂存进载荷，缺一即
   以退出码 5 拒绝出包。
3. 写入 payload/share/ime/release.json（发布元数据，运行时只读）。
4. 生成 component-manifest.json（逐文件 sha256/大小/权限、运行依赖探测、启动入口、
   运行数据目录），打包为 dist/server-ime-<版本>.tar.gz 并写 .sha256。
5. 打包源码包、写构建记录 build.json（输入树摘要 + 输出哈希），更新 dist/SHA256SUMS。
6. 用安装工具自身的 load_bundle 重新解包校验整包，失败则以退出码 5 中止。
"""

from __future__ import annotations

import argparse
import gzip
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

