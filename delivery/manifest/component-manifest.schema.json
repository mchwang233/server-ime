{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/ime/component-manifest-1.schema.json",
  "title": "ime 组件交付清单 (ime.component-manifest/1)",
  "description": "描述一个可安装的输入法组件包：组件标识与版本、逐文件校验值、运行依赖、启动入口、运行数据目录与保留策略。安装工具 ime-install 与打包流程共用此清单。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "package", "compatibility", "files", "runtime", "entrypoints"],
  "properties": {
    "schema": {"const": "ime.component-manifest/1"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "kind", "license", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}([.-][0-9A-Za-z.-]+)?$"},
        "kind": {"enum": ["product", "engine", "frontend", "data", "tool"]},
        "license": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "homepage": {"type": "string"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {"const": "ime-bundle/1"},
        "payload_root": {"type": "string", "pattern": "^[A-Za-z0-9._@+/-]+$"},
        "created_at": {"type": "string"},
        "builder": {"type": "string"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": {"type": "array", "minItems": 1, "items": {"type": "string"}, "contains": {"const": "linux"}},
        "python": {"type": "string"},
        "arch": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "mode", "kind"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._@+/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
          "kind": {"enum": ["executable", "library", "data", "config", "doc", "locale"]},
          "description": {"type": "string"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "data_dirs"],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["executable", "python-module", "file"]},
              "probe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "module": {"type": "string"},
              "path": {"type": "string"},
              "minimum": {"type": "string"},
              "required": {"type": "boolean"},
              "description": {"type": "string"}
            }
          }
        },
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "data_dirs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "description"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9._@+/-]+$"},
              "description": {"type": "string", "minLength": 1},
              "preserve": {"type": "boolean"}
            }
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "argv"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["cli", "engine", "panel", "service", "setup"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "description": {"type": "string"},
          "env": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link_dir": {"const": "bin"},
        "retain_versions": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "preserve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_globs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "notes": {"type": "string"}
  }
}
